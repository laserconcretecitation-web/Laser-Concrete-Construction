areas:()=>head("Service Areas","Proudly serving Ocean View and coastal Sussex County, Delaware.")+`<section><div class="wrap"><div class="areas">${AREAS.map(a=>`<div>${a}<span>Concrete & construction services</span></div>`).join("")}</div><p style="margin-top:30px">Don't see your town? Contact us and we will let you know if we can help.</p></div></section>`,
gallery:()=>head("Gallery","A look at the work we do.")+`<section><div class="wrap"><div class="gal">${GAL.map((g,i)=>IMG(g,S[i].n+" project")).join("")}</div></div></section>`,
contact:()=>head("Contact Us","Reach us by phone or email. We reply during business hours.")+`<section><div class="wrap cols" style="align-items:start">${contactBlock()}<div class="cbox"><h3>Business Details</h3><ul class="tick"><li>14629 Blue Heron Dr, Ocean View, Delaware 19970</li><li>Monday to Friday, 8:00 AM – 5:00 PM</li><li><a href="mailto:${MAIL}">${MAIL}</a></li></ul><a class="btn" href="${GMB}" target="_blank" rel="noopener">View on Google</a></div></div></section>`
};
function svc(id){const s=S.find(x=>x.id===id);if(!s)return P.home();
 const others=S.filter(x=>x.id!==id).slice(0,3);
 return head(s.n,s.d,s.img)+`<section><div class="wrap cols">${IMG(s.img,s.n+" in Ocean View, DE")}<div><h2 style="font-size:2.4rem;margin-bottom:14px">${s.n} in Ocean View, DE</h2><p>${s.p}</p><ul class="tick">${s.l.map(i=>`<li>${i}</li>`).join("")}</ul>${ctaCall} ${ctaMail.replace("btn ghost","btn ghost dk")}${RP}${RM}</div></div></section><section class="stone"><div class="wrap"><div class="head"><h2>Other Services</h2></div><div class="grid">${others.map(card).join("")}</div></div></section>`}
function reveal(b){document.getElementById("phoneReveal").classList.add("on");b.textContent="Call Us Now";b.onclick=()=>location.href="tel:"+TEL}
function revealMail(b){document.getElementById("mailReveal").classList.add("on");b.textContent="Send Email";b.onclick=()=>location.href="mailto:"+MAIL+"?subject=Project%20Inquiry"}
function route(){const h=location.hash.replace("#/","")||"home";const app=document.getElementById("app");
 let html;if(h.startsWith("service/"))html=svc(h.split("/")[1]);else html=(P[h]||P.home)();
 app.innerHTML=`<div class="page show">${html}</div>`;window.scrollTo(0,0);
 document.querySelector("nav").classList.remove("open");
 document.querySelectorAll("nav a.l").forEach(a=>a.classList.toggle("act",a.getAttribute("href")==="#/"+(h.startsWith("service/")?"services":h)));
 bind()}
function bind(){document.querySelectorAll(".tilt").forEach(el=>{
 el.addEventListener("mousemove",e=>{const r=el.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;el.style.transform=`perspective(900px) rotateY(${x*12}deg) rotateX(${-y*12}deg) translateZ(10px)`});
 el.addEventListener("mouseleave",()=>el.style.transform="")});
 document.querySelectorAll("img").forEach(i=>i.onerror=()=>{i.style.background="linear-gradient(135deg,#3b4350,#8a8f98)";i.style.visibility="visible"})}
addEventListener("scroll",()=>{const h=document.querySelector(".hero");if(h)h.style.setProperty("--py",(scrollY*.25)+"px")},{passive:true});
addEventListener("hashchange",route);
document.getElementById("ddServ").innerHTML=S.map(s=>`<a href="#/service/${s.id}">${s.n}</a>`).join("");
document.getElementById("yr").textContent=new Date().getFullYear();
route();
addEventListener("load",()=>setTimeout(()=>document.getElementById("loader").classList.add("off"),1500));
</script>
</body>
</html>
